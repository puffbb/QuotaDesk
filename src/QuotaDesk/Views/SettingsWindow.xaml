<Window x:Class="QuotaDesk.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QuotaDesk 设置" Width="390" Height="500" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="{DynamicResource TextPrimary}" Topmost="True" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Line" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,8,0,12" Margin="0,0,22,0">
     <ContentPresenter ContentSource="Header"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource GlmAccent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Line" Property="Background" Value="{DynamicResource TabFocusTint}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True"/></Border>
     <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,16,0,0"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HelpText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource HelpText}"><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <!-- 主题三档胶囊单选：选中 = GLM 强调色底。 -->
  <Style x:Key="ThemeChip" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Bd" Background="{DynamicResource ChipBg}" CornerRadius="999" Padding="13,5">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipHoverBg}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlmAccent}"/><Setter Property="Foreground" Value="{DynamicResource AccentFg}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Background="{DynamicResource BgRoot}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="20">
  <Grid>
   <Border Background="{DynamicResource AuroraGlow}" CornerRadius="20" IsHitTestVisible="False"/>
   <Grid Margin="24,20,24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
     <StackPanel><TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="QuotaDesk · 按你的习惯显示额度" Style="{StaticResource HelpText}" Margin="0,4,0,0"/></StackPanel>
     <Button Content="&#xE711;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="关闭设置" Click="Cancel_Click"/>
    </Grid>
    <TabControl Grid.Row="1">
     <TabItem Header="显示">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,0,4,0">
        <TextBlock Text="主题" Style="{StaticResource SectionLabel}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
         <RadioButton x:Name="ThemeSystemCheck" GroupName="Theme" Content="跟随系统" Style="{StaticResource ThemeChip}" ToolTip="随 Windows 深浅色自动切换"/>
         <RadioButton x:Name="ThemeLightCheck" GroupName="Theme" Content="浅色 · 极光晨光" Style="{StaticResource ThemeChip}"/>
         <RadioButton x:Name="ThemeDarkCheck" GroupName="Theme" Content="深色 · 极光夜幕" Style="{StaticResource ThemeChip}"/>
        </StackPanel>
        <TextBlock Text="任务栏挂件的文字颜色始终自动匹配任务栏深浅，不受此设置影响。" Style="{StaticResource HelpText}" Margin="0,0,0,14"/>
        <TextBlock Text="窗口" Style="{StaticResource SectionLabel}"/>
        <CheckBox x:Name="TopmostCheck" Content="窗口置顶" Style="{StaticResource ToggleSwitch}"/>
        <CheckBox x:Name="LockCheck" Content="锁定位置" Style="{StaticResource ToggleSwitch}" ToolTip="锁定后仍可点击切换模式"/>
        <CheckBox x:Name="RemainingCheck" Content="显示剩余比例" Style="{StaticResource ToggleSwitch}" ToolTip="关闭后显示已用比例"/>
        <CheckBox x:Name="TaskbarWidgetCheck" Content="任务栏额度挂件" Style="{StaticResource ToggleSwitch}" ToolTip="嵌在任务栏通知区左侧，双行显示两个平台的 5h/周额度"/>
        <TextBlock Text="任务栏挂件显示在通知区 &quot;^&quot; 左侧，悬停看详情、可按住横向拖动。" Style="{StaticResource HelpText}"/>
        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Margin="0,12,0,16"/>
        <TextBlock Text="启动" Style="{StaticResource SectionLabel}"/>
        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Style="{StaticResource ToggleSwitch}"/>
        <TextBlock Text="关闭悬浮窗会隐藏到托盘，退出请使用托盘菜单。" Style="{StaticResource HelpText}" Margin="0,18,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="截图">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,0,4,0">
        <TextBlock Text="快捷截图" Style="{StaticResource SectionLabel}"/>
        <CheckBox x:Name="ScreenshotEnabledCheck" Content="启用截图快捷键" Style="{StaticResource ToggleSwitch}"/>
        <TextBlock Text="截图快捷键" Style="{StaticResource HelpText}" Margin="0,14,0,6"/>
        <TextBox x:Name="ScreenshotShortcutBox" Style="{StaticResource SettingsField}" IsReadOnly="True" PreviewKeyDown="ScreenshotShortcut_KeyDown" ToolTip="点击后按下组合键"/>
        <TextBlock x:Name="ScreenshotShortcutHint" Text="点击输入框，然后按下 Ctrl、Alt 或 Shift 加字母、数字或 F1–F12。" Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
        <TextBlock Text="截图时单击自动选中的窗口或控件，也可以拖动框选。截图完成后复制到剪贴板；按 Esc 或鼠标右键取消。" Style="{StaticResource HelpText}" Margin="0,18,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="数据来源">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,0,4,0">
        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
         <StackPanel><TextBlock Text="Codex" FontWeight="SemiBold"/><CheckBox x:Name="CodexRealCheck" Content="使用真实数据" Style="{StaticResource ToggleSwitch}"/><TextBlock Text="读取本机 Codex 登录。关闭后使用演示数据。" Style="{StaticResource HelpText}"/></StackPanel>
        </Border>
        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="14">
         <StackPanel>
          <TextBlock Text="GLM · 智谱国内" FontWeight="SemiBold"/>
          <CheckBox x:Name="GlmRealCheck" Content="使用真实数据" Style="{StaticResource ToggleSwitch}"/>
          <TextBlock Text="Coding Plan API Key" Style="{StaticResource HelpText}" Margin="0,4,0,6"/>
          <PasswordBox x:Name="GlmKeyBox" PasswordChar="●" Background="{DynamicResource BgRoot}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderSoft}" Padding="8,6" FontSize="12" ToolTip="粘贴智谱国内 API Key，保存后加密存储"/>
          <Grid Margin="0,8,0,0"><Button x:Name="GlmKeySave" Content="保存密钥" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="GlmKeySave_Click"/><Button x:Name="GlmKeyDelete" Content="删除" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Click="GlmKeyDelete_Click"/></Grid>
          <TextBlock x:Name="GlmKeyStatus" Style="{StaticResource HelpText}" Margin="0,7,0,0"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="通知与刷新">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,0,4,0">
        <TextBlock Text="额度提醒" Style="{StaticResource SectionLabel}"/>
        <CheckBox x:Name="LowQuotaNotifyCheck" Content="低额度通知" Style="{StaticResource ToggleSwitch}"/>
        <TextBlock Text="同一额度周期内，每个阈值只提醒一次。" Style="{StaticResource HelpText}" Margin="0,0,0,18"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,10,0"><TextBlock Text="警告阈值 · 剩余 %" Style="{StaticResource HelpText}"/><TextBox x:Name="WarnBox" Style="{StaticResource SettingsField}" Margin="0,6,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="严重阈值 · 剩余 %" Style="{StaticResource HelpText}"/><TextBox x:Name="CriticalBox" Style="{StaticResource SettingsField}" Margin="0,6,0,0"/></StackPanel>
        </Grid>
        <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Margin="0,22,0,18"/>
        <TextBlock Text="自动刷新" Style="{StaticResource SectionLabel}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center"><TextBlock Text="刷新间隔"/><TextBlock Text="秒 · 30–3600" Style="{StaticResource HelpText}" Margin="0,3,0,0"/></StackPanel>
         <TextBox x:Name="RefreshBox" Grid.Column="1" Style="{StaticResource SettingsField}"/>
        </Grid>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,18,0,0">
     <TextBlock Text="偏好仅保存在本机" Style="{StaticResource HelpText}" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" Style="{StaticResource FlatButton}" Padding="12,8" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
