<Window x:Class="QuotaDesk.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QuotaDesk.Controls" Title="QuotaDesk" Width="248" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True" Topmost="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
 <Window.Resources>
 <DataTemplate x:Key="CompactMetric">
  <StackPanel ToolTip="{Binding ToolTip}">
   <Grid Margin="0,0,0,4"><TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding PercentText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{Binding Severity, Converter={StaticResource PctBrush}}"/></Grid>
   <controls:MiniBar Height="3" Fraction="{Binding Fraction}" Track="{DynamicResource TrackBar}"><controls:MiniBar.Fill><MultiBinding Converter="{StaticResource AccentBar}"><Binding Path="Severity"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></controls:MiniBar.Fill></controls:MiniBar>
  </StackPanel>
 </DataTemplate>
<DataTemplate x:Key="DetailMetric">
 <StackPanel Margin="0,0,0,0" ToolTip="{Binding ToolTip}">
  <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
  <TextBlock Text="{Binding PercentText}" FontSize="26" FontWeight="SemiBold" Margin="0,1,0,5" Foreground="{Binding Severity, Converter={StaticResource PctBrush}}"/>
  <controls:MiniBar Height="5" Fraction="{Binding Fraction}" Track="{DynamicResource TrackBar}">
   <controls:MiniBar.Fill><MultiBinding Converter="{StaticResource AccentBar}"><Binding Path="Severity"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></controls:MiniBar.Fill>
  </controls:MiniBar>
  <TextBlock Text="{Binding RightText}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
<TextBlock Text="{Binding StatusText}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BarWarn}" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
 </StackPanel>
</DataTemplate>
<DataTemplate x:Key="RailMetric">
 <StackPanel Margin="0,8,0,0" ToolTip="{Binding ToolTip}">
  <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
  <TextBlock Text="{Binding PercentText}" FontSize="17" FontWeight="SemiBold" Margin="0,1,0,5" Foreground="{Binding Severity, Converter={StaticResource PctBrush}}"/>
  <controls:MiniBar Height="3" Fraction="{Binding Fraction}" Track="{DynamicResource TrackBar}">
   <controls:MiniBar.Fill><MultiBinding Converter="{StaticResource AccentBar}"><Binding Path="Severity"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></controls:MiniBar.Fill>
  </controls:MiniBar>
  <TextBlock Text="{Binding CompactSuffix}" FontSize="9" Margin="0,2,0,0" Foreground="{DynamicResource BarWarn}" Visibility="{Binding CompactSuffix, Converter={StaticResource NullToVis}}"/>
 </StackPanel>
</DataTemplate>
 <DataTemplate x:Key="CompactRowTemplate">
  <StackPanel Margin="0,5" ToolTip="{Binding StatusText}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{Binding ProviderId, Converter={StaticResource ProviderDot}}" Margin="0,0,5,0"/><TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
    <ItemsControl Grid.Column="1" Tag="{Binding ProviderId}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CompactMetric}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="8,0,0,0"/></Style></ItemsControl.ItemContainerStyle>
    </ItemsControl>
   </Grid>
   <TextBlock Text="{Binding RowIssueText}" FontSize="9" Margin="0,3,0,0" Foreground="{DynamicResource BarWarn}" Visibility="{Binding RowIssueText, Converter={StaticResource NullToVis}}"/>
   <TextBlock Text="{Binding ErrorText}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BarWarn}" Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
  </StackPanel>
 </DataTemplate>
 <DataTemplate x:Key="ProviderCardTemplate">
  <Border Style="{StaticResource ProviderCard}" Padding="12">
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Margin="0,0,7,0" Fill="{Binding ProviderId, Converter={StaticResource ProviderDot}}"/><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="模拟" FontSize="9" Margin="6,2,0,0" Foreground="{DynamicResource DemoFg}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}"/></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding UpdateText}" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" ToolTip="{Binding UpdateText}"/>
    </Grid>
    <ItemsControl Tag="{Binding ProviderId}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource DetailMetric}" Margin="0,12,0,0">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,10,0"/></Style></ItemsControl.ItemContainerStyle>
    </ItemsControl>
    <TextBlock Text="{Binding ErrorText}" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BarWarn}" Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
   </StackPanel>
  </Border>
 </DataTemplate>
 <DataTemplate x:Key="MiniRowTemplate">
  <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,10,0,12" ToolTip="{Binding StatusText}">
   <StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="4" Height="4" Margin="0,0,4,0" Fill="{Binding ProviderId, Converter={StaticResource ProviderDot}}"/><TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/></StackPanel>
    <TextBlock Text="模拟" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource DemoFg}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}"/>
    <ItemsControl Tag="{Binding ProviderId}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RailMetric}"/>
    <TextBlock Text="!" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource BarWarn}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" ToolTip="{Binding ErrorText}"/>
   </StackPanel>
  </Border>
 </DataTemplate>
 </Window.Resources>
 <Border x:Name="Root" Background="{DynamicResource BgRoot}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="13" SnapsToDevicePixels="True">
  <Grid>
   <Border x:Name="Glow" Background="{DynamicResource AuroraGlow}" CornerRadius="13" IsHitTestVisible="False"/>
   <Grid x:Name="CompactPanel">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
    <StackPanel Margin="12,7,9,7"><TextBlock Text="演示数据" FontSize="9" Foreground="{DynamicResource DemoFg}" Visibility="{Binding HasDemo, Converter={StaticResource BoolToVis}}"/><ItemsControl x:Name="CompactList" ItemsSource="{Binding Providers}" ItemTemplate="{StaticResource CompactRowTemplate}"/></StackPanel>
    <Border Grid.Column="1" Background="{DynamicResource RailVeil}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0" CornerRadius="0,13,13,0">
     <StackPanel VerticalAlignment="Center">
      <Button x:Name="RatioButton" Style="{StaticResource FlatButton}" Content="{Binding RatioLabel}" FontSize="10" Padding="0,5" ToolTip="{Binding RatioToolTip}" Click="RatioButton_Click"/>
      <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Padding="0,5" ToolTip="隐藏到托盘" Click="CloseButton_Click"/>
     </StackPanel>
    </Border>
   </Grid>
   <Grid x:Name="DetailedPanel" Margin="15" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource GlmAccent}" Width="24" Height="24" CornerRadius="7" Margin="0,0,8,0"><TextBlock Text="Q" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="QuotaDesk" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource FlatButton}" Content="{Binding RatioLabel}" Padding="5,4" FontSize="10" ToolTip="{Binding RatioToolTip}" Click="RatioButton_Click"/><Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="隐藏到托盘" Click="CloseButton_Click"/></StackPanel>
    </Grid>
    <ItemsControl x:Name="DetailedList" Grid.Row="1" ItemsSource="{Binding Providers}" ItemTemplate="{StaticResource ProviderCardTemplate}"/>
    <Grid x:Name="BottomBar" Grid.Row="2" Margin="0,2,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="刷新中…" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"/>
     <Button x:Name="RefreshButton" Style="{StaticResource FlatButton}" Content="刷新" FontSize="11" Padding="6,4" HorizontalAlignment="Right" ToolTip="刷新两个平台的额度" Click="RefreshButton_Click"/>
     <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0"><Grid><Button Style="{StaticResource FlatButton}" Content="收起" HorizontalAlignment="Left" FontSize="10" Click="CollapseButton_Click"/><Button Style="{StaticResource FlatButton}" Content="设置" HorizontalAlignment="Right" FontSize="10" Click="SettingsButton_Click"/></Grid></Border>
    </Grid>
   </Grid>
   <StackPanel x:Name="MiniPanel" Margin="8,10,8,8" Visibility="Collapsed">
    <Border Height="3" Width="18" CornerRadius="2" Background="{DynamicResource Grip}" Margin="0,0,0,6"/>
    <Button Style="{StaticResource FlatButton}" Content="{Binding RatioLabel}" FontSize="10" Padding="0,2" ToolTip="{Binding RatioToolTip}" Click="RatioButton_Click"/>
    <ItemsControl x:Name="MiniList" ItemsSource="{Binding Providers}" ItemTemplate="{StaticResource MiniRowTemplate}"/>
    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" HorizontalAlignment="Center" Margin="0,6,0,0" ToolTip="展开详细版" Click="ExpandButton_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>