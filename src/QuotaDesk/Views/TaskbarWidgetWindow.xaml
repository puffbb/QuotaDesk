<Window x:Class="QuotaDesk.Views.TaskbarWidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:QuotaDesk.Controls" Title="QuotaDesk 任务栏挂件" Width="216" Height="204" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False" ResizeMode="NoResize" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="11" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <!-- WidgetText/WidgetName/WidgetDim 与 WidgetPctBrush 定义在 App.xaml：颜色由 ThemeManager 按系统任务栏深浅原地改写。 -->

  <!-- 悬停详情卡：单个额度窗口（小号紧凑度量）。
       卡内不放 Tooltip：卡片本身已内联展示状态行/错误/行状态，嵌套 Tooltip 会浮在内容上遮挡（用户反馈），
       行级别信息（重置倒计时/时间）由 RightText 行直接展示。 -->
  <DataTemplate x:Key="PopMetric">
   <StackPanel>
    <Grid Margin="0,0,0,4"><TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding PercentText}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{Binding Severity, Converter={StaticResource PctBrush}}"/></Grid>
    <controls:MiniBar Height="3" Fraction="{Binding Fraction}" Track="{DynamicResource TrackBar}"><controls:MiniBar.Fill><MultiBinding Converter="{StaticResource AccentBar}"><Binding Path="Severity"/><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/></MultiBinding></controls:MiniBar.Fill></controls:MiniBar>
    <TextBlock Text="{Binding RightText}" FontSize="9.5" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Visibility="{Binding RightText, Converter={StaticResource NullToVis}}"/>
    <TextBlock Text="{Binding StatusText}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BarWarn}" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
   </StackPanel>
  </DataTemplate>

  <!-- 悬停详情卡：一个平台 -->
  <DataTemplate x:Key="PopProvider">
    <StackPanel Margin="0,0,0,11">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
     <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding ProviderId, Converter={StaticResource ProviderDot}}"/>
     <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
     <TextBlock Text="模拟" FontSize="9" Margin="6,1,0,0" Foreground="{DynamicResource DemoFg}" Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
    <!-- 状态行：更新时间 + 来源；换行展示，不截断（来源/时间信息用户需要完整看到）。 -->
    <TextBlock Text="{Binding DetailLine}" FontSize="9.5" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Visibility="{Binding DetailLine, Converter={StaticResource NullToVis}}"/>
    <ItemsControl Tag="{Binding ProviderId}" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PopMetric}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Margin" Value="0,0,12,0"/></Style></ItemsControl.ItemContainerStyle>
    </ItemsControl>
    <TextBlock Text="{Binding ErrorText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BarWarn}" Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
   </StackPanel>
  </DataTemplate>

  <!-- 深色右键菜单（与 Aurora 主题一致） -->
  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="{DynamicResource CardBg}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ContextMenu">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
       <StackPanel IsItemsHost="True"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="MenuItem">
      <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,6">
       <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBg}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Opacity" Value="0.6"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Separator">
   <Setter Property="Background" Value="{DynamicResource BorderSoft}"/>
   <Setter Property="Height" Value="1"/>
   <Setter Property="Margin" Value="6,4"/>
  </Style>

  <!-- 详情卡滚动条：空间不足时才出现；窄条、随主题配色，只作用于本窗口。 -->
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/>
   <Setter Property="MinWidth" Value="6"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
       <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        <Track.Thumb>
         <Thumb Focusable="False">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource WidgetDim}" CornerRadius="3" Opacity="0.55"/></ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>

 <Grid x:Name="Root">
  <!-- 独立弹层不改变任务栏挂件窗口的尺寸或命中区域。 -->
  <Popup x:Name="Popup" PlacementTarget="{Binding ElementName=Widget}" Placement="Top" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
   <Border x:Name="CardSurface" Width="206" Background="{DynamicResource BgRoot}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="12" Padding="12,10,12,2" MouseEnter="Popup_MouseEnter" MouseLeave="Popup_MouseLeave">
    <ScrollViewer x:Name="PopupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
     <ItemsControl ItemsSource="{Binding Providers}" ItemTemplate="{StaticResource PopProvider}"/>
    </ScrollViewer>
   </Border>
  </Popup>

  <!-- T2 双行挂件本体：嵌在任务栏通知区左侧 -->
  <Border x:Name="Widget" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2" Height="36" CornerRadius="7" Background="#01000000" Padding="9,0" Cursor="Hand"
          MouseEnter="Widget_MouseEnter" MouseLeave="Widget_MouseLeave"
          MouseLeftButtonDown="Widget_MouseLeftButtonDown" MouseMove="Widget_MouseMove" MouseLeftButtonUp="Widget_MouseLeftButtonUp">
    <Border.ContextMenu>
    <ContextMenu Placement="Top" PlacementTarget="{Binding ElementName=Widget}">
     <MenuItem Header="立即刷新" Click="RefreshMenu_Click"/>
     <MenuItem Header="打开主窗口" Click="OpenMain_Click"/>
     <MenuItem Header="设置…" Click="SettingsMenu_Click"/>
     <Separator/>
     <MenuItem x:Name="ResetAlignItem" Header="恢复自动吸附" Click="ResetAlign_Click"/>
     <MenuItem Header="隐藏任务栏挂件" Click="HideWidget_Click"/>
    </ContextMenu>
   </Border.ContextMenu>
   <StackPanel VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
     <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource GlmAccent}"/>
     <TextBlock Text="GLM" FontSize="9.5" Foreground="{DynamicResource WidgetName}" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="GlmText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetText}" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource CodexAccent}"/>
     <TextBlock Text="Codex" FontSize="9.5" Foreground="{DynamicResource WidgetName}" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBlock x:Name="CodexText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetText}" VerticalAlignment="Center"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</Window>
